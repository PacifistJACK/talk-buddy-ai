# Google Gemini API Key (Required for LangChain Agent)
GOOGLE_API_KEY=your_google_api_key_here

# Microsoft Azure Speech Credentials (Optional - For Azure Student Account credits & low-latency STT/TTS)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia

# Hugging Face Token (Optional - if using Hugging Face Space TTS)
HF_TOKEN=your_huggingface_token_here
